<Window x:Class="RobloxAccountManager.App.MixerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mixer" Width="1060" Height="760" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource MonoBox}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <!-- 混音台每次開啟都重建，這裡的 StaticResource 會拿到當下主題的 MonoBox -->

    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="16,6">
            <TextBlock x:Name="StatusText" Style="{StaticResource Dim}"/>
        </Border>

        <Grid Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <UniformGrid Columns="2">
                <!-- 效能限制 -->
                <Border Style="{StaticResource Card}" Padding="16,12,16,6" Margin="0,0,6,10">
                    <StackPanel>
                        <TextBlock x:Name="SecLimits" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <TextBlock x:Name="LblFps" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FpsBox" Style="{StaticResource NumBox}" Margin="0,0,8,0"/>
                            <Button x:Name="BtnFps" Style="{StaticResource Small}" Click="Fps_Click"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock x:Name="LblCpu" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CpuBox" Style="{StaticResource NumBox}" Width="56"/>
                            <TextBlock Text="%" Style="{StaticResource FieldLabel}" Margin="6,0,16,0"/>
                            <TextBlock x:Name="LblRam" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RamBox" Style="{StaticResource NumBox}"/>
                            <TextBlock Text="MB" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button x:Name="BtnApplySel" Style="{StaticResource Small}" Click="ApplySel_Click"/>
                            <Button x:Name="BtnApplyAll" Style="{StaticResource Small}" Click="ApplyAll_Click"/>
                            <Button x:Name="BtnClear" Style="{StaticResource Small}" Click="Clear_Click"/>
                        </WrapPanel>
                        <CheckBox x:Name="ChkAuto" Margin="0,0,0,4"/>
                        <TextBlock x:Name="LblHint" Style="{StaticResource Dim}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8"/>
                    </StackPanel>
                </Border>

                <!-- 視窗 -->
                <Border Style="{StaticResource Card}" Padding="16,12,16,6" Margin="6,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="SecWindow" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <TextBlock x:Name="LblWin" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="WinW" Style="{StaticResource NumBox}"/>
                            <TextBlock Text="×" Style="{StaticResource FieldLabel}" Margin="8,0"/>
                            <TextBox x:Name="WinH" Style="{StaticResource NumBox}"/>
                        </WrapPanel>
                        <CheckBox x:Name="ChkTile" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkWinLaunch" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button x:Name="BtnWinApply" Style="{StaticResource Small}" Click="WinApply_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 音訊與處理程序 -->
                <Border Style="{StaticResource Card}" Padding="16,12,16,6" Margin="0,0,6,10">
                    <StackPanel>
                        <TextBlock x:Name="SecAudio" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <TextBlock x:Name="LblVol" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="VolSlider" Width="150" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center"
                                    TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding Value, ElementName=VolSlider, StringFormat={}{0:F0}%}" Width="46" Margin="8,0,0,0"
                                       VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button x:Name="BtnVolSel" Style="{StaticResource Small}" Click="VolSel_Click"/>
                            <Button x:Name="BtnVolAll" Style="{StaticResource Small}" Click="VolAll_Click"/>
                            <Button x:Name="BtnMute" Style="{StaticResource Small}" Click="Mute_Click"/>
                            <Button x:Name="BtnUnmute" Style="{StaticResource Small}" Click="Unmute_Click"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock x:Name="LblPrio" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="PrioBox" Width="140" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                            <Button x:Name="BtnPrioSel" Style="{StaticResource Small}" Click="PrioSel_Click"/>
                            <Button x:Name="BtnPrioAll" Style="{StaticResource Small}" Click="PrioAll_Click"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button x:Name="BtnTrimSel" Style="{StaticResource Small}" Click="TrimSel_Click"/>
                            <Button x:Name="BtnTrimAll" Style="{StaticResource Small}" Click="TrimAll_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 圖形 -->
                <Border Style="{StaticResource Card}" Padding="16,12,16,6" Margin="6,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="SecGfx" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <TextBlock x:Name="LblRender" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="RenderBox" Width="130" Margin="0,0,16,0"/>
                            <TextBlock x:Name="LblQuality" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="QualityBox" Style="{StaticResource NumBox}" Width="56"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button x:Name="BtnGfx" Style="{StaticResource Small}" Click="Gfx_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="LblGfxHint" Style="{StaticResource Dim}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 執行中的實例 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,10,8,6">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,0,4,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnKillSel" Style="{StaticResource Small}" Click="KillSel_Click"/>
                            <Button x:Name="BtnKill" Style="{StaticResource Small}" Margin="0" Click="Kill_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="SecInstances" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColAcc" Binding="{Binding Account}" Width="*"/>
                            <DataGridTextColumn x:Name="ColPid" Binding="{Binding Pid}" Width="80" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn x:Name="ColMem" Binding="{Binding MemoryMb, StringFormat={}{0:F0}}" Width="110" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn x:Name="ColCpu" Binding="{Binding CpuPercent, StringFormat={}{0:F1}}" Width="80" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn x:Name="ColVol" Binding="{Binding VolumeText}" Width="80" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn x:Name="ColPrio" Binding="{Binding PriorityText}" Width="110"/>
                            <DataGridTextColumn x:Name="ColLimit" Binding="{Binding LimitText}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
