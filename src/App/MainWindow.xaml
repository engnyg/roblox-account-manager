<Window x:Class="RobloxAccountManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Account Manager V3" Width="1220" Height="780" MinWidth="1000" MinHeight="560">
    <Window.Resources>
        <!-- 大頭貼外圈：帳號正在執行時亮起（清單與磚塊共用） -->
        <Style x:Key="AvatarRing" TargetType="Ellipse">
            <Setter Property="Stroke" Value="Transparent"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Running}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Running}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Dim}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Subtitle.Length}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValidGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Text" Value="&#xE73E;"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Valid}" Value="False">
                    <Setter Property="Text" Value="&#xE7BA;"/>
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 群組標籤：Default 群組不顯示，避免每列都是同一個字 -->
        <Style x:Key="GroupPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Group}" Value="Default">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="0" Background="Transparent">
            <MenuItem x:Name="MenuFile">
                <MenuItem x:Name="MiAddLogin" Click="AddByLogin_Click"/>
                <MenuItem x:Name="MiImportFile" Click="ImportFile_Click"/>
                <MenuItem x:Name="MiImportDat" Click="ImportDat_Click"/>
                <MenuItem x:Name="MiImportCookies" Click="ImportCookies_Click"/>
                <MenuItem x:Name="MiGenerate" Click="Generate_Click"/>
                <MenuItem x:Name="MiExportCookies" Click="ExportCookies_Click"/>
                <Separator/>
                <MenuItem x:Name="MiExit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem x:Name="MenuAccounts">
                <MenuItem x:Name="MiEdit" Click="CmEdit_Click"/>
                <MenuItem x:Name="MiTools" Click="AccountTools_Click"/>
                <MenuItem x:Name="MiBrowser" Click="CmBrowser_Click"/>
                <Separator/>
                <MenuItem x:Name="MiCheckAll" Click="CheckAll_Click"/>
                <MenuItem x:Name="MiUncheckAll" Click="UncheckAll_Click"/>
                <Separator/>
                <MenuItem x:Name="MiKillSel" Click="CmKill_Click"/>
                <MenuItem x:Name="MiKillChecked" Click="KillChecked_Click"/>
                <MenuItem x:Name="MiTrimSel" Click="CmTrim_Click"/>
                <Separator/>
                <MenuItem x:Name="MiRefreshInfo" Click="RefreshInfo_Click"/>
            </MenuItem>
            <MenuItem x:Name="MenuGame">
                <MenuItem x:Name="MiJoin" Click="Join_Click"/>
                <MenuItem x:Name="MiJoinPrivate" Click="JoinPrivate_Click"/>
                <MenuItem x:Name="MiServers" Click="ServerList_Click"/>
                <MenuItem x:Name="MiCharts" Click="Charts_Click"/>
                <Separator/>
                <MenuItem x:Name="MiMulti" IsCheckable="True" Click="MultiRoblox_Click"/>
                <MenuItem x:Name="MiAfk" IsCheckable="True" Click="AntiAfk_Click"/>
                <MenuItem x:Name="MiFps" Click="Fps_Click"/>
            </MenuItem>
            <MenuItem x:Name="MenuView">
                <MenuItem x:Name="MiLayoutList" IsCheckable="True" Click="LayoutList_Click"/>
                <MenuItem x:Name="MiLayoutTiles" IsCheckable="True" Click="LayoutTiles_Click"/>
            </MenuItem>
            <MenuItem x:Name="MenuTools">
                <MenuItem x:Name="MiMixer" Click="Mixer_Click"/>
                <MenuItem x:Name="MiLogs" Click="Logs_Click"/>
                <MenuItem x:Name="MiTracking" Click="Tracking_Click"/>
                <MenuItem x:Name="MiNexus" Click="Nexus_Click"/>
                <MenuItem x:Name="MiWebPanel" Click="WebPanel_Click"/>
                <Separator/>
                <MenuItem x:Name="MiSettings" Click="Settings_Click"/>
                <MenuItem x:Name="MiUpdate" Click="CheckUpdate_Click"/>
                <MenuItem x:Name="MiHelp" Click="Help_Click"/>
            </MenuItem>
        </Menu>

        <!-- 狀態列 -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="18,6">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Dim}"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Dim}"/>
            </DockPanel>
        </Border>

        <Grid Margin="16,10,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 左側：群組與執行中 ============ -->
            <DockPanel Margin="0,0,16,0">
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <TextBlock x:Name="LblRunning" Style="{StaticResource Eyebrow}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RunningText" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RunningOf" Style="{StaticResource Dim}" VerticalAlignment="Bottom" Margin="8,0,0,9"/>
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Mono}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="LblGroup" DockPanel.Dock="Top" Style="{StaticResource Eyebrow}" Margin="10,6,0,6"/>
                <ListBox x:Name="GroupList" SelectionChanged="Group_Changed" SelectedValuePath="Value"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontFamily="{StaticResource DisplayFont}"
                                           FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RunningText}" FontFamily="{StaticResource DisplayFont}" FontSize="12"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ============ 右側 ============ -->
            <DockPanel Grid.Column="1">

                <!-- 目的地：要把帳號送去哪裡 -->
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.RowSpan="2" Width="96" Height="96" VerticalAlignment="Top">
                            <Border CornerRadius="16" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"/>
                            <TextBlock x:Name="GameGlyph" Style="{StaticResource Glyph}" Text="&#xE7FC;" FontSize="34"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <Image x:Name="GameIcon" Stretch="UniformToFill">
                                <Image.Clip><RectangleGeometry Rect="0,0,96,96" RadiusX="16" RadiusY="16"/></Image.Clip>
                            </Image>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="18,0,16,0">
                            <TextBlock x:Name="LblDest" Style="{StaticResource Eyebrow}"/>
                            <TextBlock x:Name="GameName" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                                       FontStretch="SemiCondensed" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="GameMeta" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.Column="1" Margin="18,12,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LblPlace" Style="{StaticResource Eyebrow}"/>
                                <TextBox x:Name="PlaceBox" Style="{DynamicResource MonoBox}" TextChanged="Place_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LblJob" Style="{StaticResource Eyebrow}"/>
                                <TextBox x:Name="JobBox" Style="{DynamicResource MonoBox}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" Width="210">
                            <Button x:Name="BtnLaunchChecked" Style="{StaticResource AccentButtonStyle}" Height="48"
                                    HorizontalAlignment="Stretch" Click="LaunchChecked_Click">
                                <DockPanel LastChildFill="False" Width="178">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="LaunchCheckedText" DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LaunchCheckedCount" DockPanel.Dock="Right" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                            <Button x:Name="BtnJoin" Margin="0,8,0,0" Height="34" HorizontalAlignment="Stretch" Click="Join_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 指令列 -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnLaunchGroup" Padding="14,6" Click="LaunchGroup_Click"/>
                        <Button x:Name="BtnKillChecked" Padding="14,6" Margin="8,0,0,0" Click="KillChecked_Click"/>
                        <Border Width="1" Margin="12,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                        <ToggleButton x:Name="BtnViewList" Padding="10,6" Click="LayoutList_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnViewTiles" Padding="10,6" Margin="4,0,0,0" Click="LayoutTiles_Click">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE80A;"/>
                        </ToggleButton>
                    </StackPanel>
                    <Grid Width="300" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" Padding="34,6,8,6" VerticalContentAlignment="Center" TextChanged="Search_Changed"/>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="12,0,0,0" HorizontalAlignment="Left"
                                   IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="LblSearch" Margin="35,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>

                <!-- 帳號 -->
                <Border Style="{StaticResource Card}" Padding="6,4">
                    <Grid>
                        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                                  SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="56"
                                  MouseDoubleClick="Grid_DoubleClick" PreviewMouseRightButtonDown="Row_RightClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu Opened="Context_Opened">
                                    <MenuItem x:Name="CmJoin" Click="CmJoin_Click"/>
                                    <MenuItem x:Name="CmEdit" Click="CmEdit_Click"/>
                                    <MenuItem x:Name="CmCheck" Click="CmCheck_Click"/>
                                    <MenuItem x:Name="CmUncheck" Click="CmUncheck_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="CmAlias" Click="CmAlias_Click"/>
                                    <MenuItem x:Name="CmGroup" Click="CmGroup_Click"/>
                                    <MenuItem x:Name="CmDesc" Click="CmDesc_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="CmKill" Click="CmKill_Click"/>
                                    <MenuItem x:Name="CmTrim" Click="CmTrim_Click"/>
                                    <MenuItem x:Name="CmPriority"/>
                                    <MenuItem x:Name="CmBrowser" Click="CmBrowser_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="CmCopyUser" Click="CmCopyUser_Click"/>
                                    <MenuItem x:Name="CmCopyCookie" Click="CmCopyCookie_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="CmRemove" Click="CmRemove_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="ColCheck" Width="48" SortMemberPath="Checked">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Checked, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColUser" Width="*" MinWidth="220" SortMemberPath="Username" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel VerticalAlignment="Center">
                                                <Grid Width="40" Height="40" DockPanel.Dock="Left">
                                                    <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="3"/>
                                                    <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" Margin="3">
                                                        <Image.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17"/></Image.Clip>
                                                    </Image>
                                                    <Ellipse Style="{StaticResource AvatarRing}"/>
                                                </Grid>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtitle}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColGroup" Width="130" SortMemberPath="Group" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GroupPill}">
                                                <TextBlock Text="{Binding Group}" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColStatus" Width="120" SortMemberPath="Pid" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding PidText}" Style="{StaticResource Mono}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColTarget" Width="170" SortMemberPath="TargetText" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TargetText}" Style="{StaticResource Mono}" VerticalAlignment="Center" ToolTip="{Binding TargetText}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColLast" Width="130" SortMemberPath="LastUse" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastUse, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColValid" Width="56" SortMemberPath="Valid" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource ValidGlyph}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ListBox x:Name="Tiles" Visibility="Collapsed" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4"
                                 MouseDoubleClick="Tiles_DoubleClick" PreviewMouseRightButtonDown="Row_RightClick"
                                 ContextMenu="{Binding ContextMenu, ElementName=Grid}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Margin" Value="3"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="272" Height="100" Padding="12,10" CornerRadius="10" BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="4"/>
                                                <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" Margin="4">
                                                    <Image.Clip><EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28"/></Image.Clip>
                                                </Image>
                                                <Ellipse Style="{StaticResource AvatarRing}" StrokeThickness="2.5"/>
                                            </Grid>
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top">
                                                    <CheckBox DockPanel.Dock="Right" MinWidth="0" Margin="6,0,0,0" VerticalAlignment="Top"
                                                              IsChecked="{Binding Checked, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Text="{Binding Username}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <DockPanel DockPanel.Dock="Bottom">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding PidText}" Style="{StaticResource Mono}" FontSize="11"/>
                                                    </StackPanel>
                                                    <Border Style="{StaticResource GroupPill}">
                                                        <TextBlock Text="{Binding Group}" FontSize="11"/>
                                                    </Border>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            </DockPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
